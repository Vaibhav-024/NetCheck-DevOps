<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NetCheck"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#20243A"
            android:gravity="center"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Network Utility Dashboard"
            android:textSize="14sp"
            android:textColor="#777777"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <!-- Internet Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Internet Status"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#20243A" />

            <TextView
                android:id="@+id/txtInternetStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#219653"
                android:paddingTop="12dp" />

        </LinearLayout>

        <!-- Network Information -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Network Information"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#20243A" />

            <TextView
                android:id="@+id/txtNetworkType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Network Type: Unknown"
                android:textSize="16sp"
                android:textColor="#444444"
                android:paddingTop="12dp" />

        </LinearLayout>

        <!-- Latency Test -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Latency Test"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#20243A" />

            <TextView
                android:id="@+id/txtPingResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Response Time: Not tested"
                android:textSize="16sp"
                android:textColor="#444444"
                android:paddingTop="12dp"
                android:paddingBottom="16dp" />

            <Button
                android:id="@+id/btnPing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Run Latency Test"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
